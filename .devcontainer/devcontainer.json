{
  "name": "arm-daemon",
  "image": "automaticrippingmachine/automatic-ripping-machine:latest",
  "runArgs": [
    "--name=arm-daemon",
      "--privileged",
      "-p", "8080:8080",
    "--device=/dev/sr0:/dev/sr0",
  ],
  "containerEnv": {
    "ARM_UID": "1000",
    "ARM_GID": "1000",
    "TZ": "UTC"
  },
  "mounts": [
    "source=/home/simon/arm/config,target=/etc/arm/config,type=bind",
    "source=/home/simon/arm/media,target=/home/arm/media,type=bind",
    "source=/home/simon/arm/logs,target=/home/arm/logs,type=bind"
  ],
    "forwardPorts": [8080],
    
// 1. Ensure host bind directories exist BEFORE mounting
    "initializeCommand": "mkdir -p ${localEnv:HOME}/arm/{config,media,logs}",

// 2. Run inside the container on creation: create all ARM subdirectories & seed default configs
  "postCreateCommand": "bash -c 'mkdir -p /home/arm/media/{completed,raw,transcode} /home/arm/logs && [ -f /etc/arm/config/arm.yaml ] || cp -n /opt/arm/setup/* /etc/arm/config/ 2>/dev/null || true && [ -f /etc/arm/config/abcde.conf ] || touch /etc/arm/config/abcde.conf && [ -f /etc/arm/config/apprise.yaml ] || touch /etc/arm/config/apprise.yaml'",

  // 3. Ensure the web server starts automatically on every up/resume
  "postStartCommand": "bash -c 'pgrep -f runui.py > /dev/null || nohup python3 /opt/arm/arm/runui.py > /home/arm/logs/armui.log 2>&1 &'",    

  "remoteUser": "arm"
}
